---
import { sections } from '../data/cv.js';
---
<aside class="rail"><nav aria-label="Índice de secciones">
  <button class="rail-arrow" data-direction="-1" aria-label="Ir a la sección anterior" disabled type="button"><span aria-hidden="true">⌃</span></button>
  <ol class="rail-list">{sections.map(([id,label],i)=><li><a href={`#${id}`} data-section-link={id} aria-label={`${String(i+1).padStart(2,'0')}. ${label}`} aria-current={i===0?'location':undefined}><span class="rail-dot" aria-hidden="true"></span><span class="rail-number">{String(i+1).padStart(2,'0')}</span><span class="rail-label">{label}</span></a></li>)}</ol>
  <button class="rail-arrow" data-direction="1" aria-label="Ir a la sección siguiente" type="button"><span aria-hidden="true">⌄</span></button>
  </nav><span class="rail-counter" aria-hidden="true"><span data-current>01</span> / {String(sections.length).padStart(2,'0')}</span></aside>
